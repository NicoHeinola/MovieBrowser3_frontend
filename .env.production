# Production build values. The web image serves the app and proxies /api to the backend on the same origin.
VITE_API_URL=/api/v1
VITE_API_TIMEOUT_MS=30000
VITE_API_CACHE_STALE_TIME_MS=60000

# Shown after the version in the top left navigation. Releases show the bare version.
VITE_APP_VERSION_SUFFIX=
