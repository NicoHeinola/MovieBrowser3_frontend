{
  "name": "moviebrowser3",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check:types": "vue-tsc --build --force",
    "check:lint": "eslint",
    "fix:lint": "eslint --fix",
    "fix:format": "prettier --write .",
    "check:format": "prettier --check .",
    "check": "run-s check:types check:lint check:format test",
    "fix": "run-s fix:lint fix:format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/vue-query": "^5.105.0",
    "@vue-dnd-kit/core": "^2.4.7",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.7.2",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "vue-demi": false
  }
}
