{
  "name": "moviebrowser3",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check:types": "vue-tsc --build --force",
    "check:lint": "eslint",
    "fix:lint": "eslint --fix",
    "fix:format": "prettier --write .",
    "check:format": "prettier --check .",
    "check": "run-s check:types check:lint check:format test",
    "fix": "run-s fix:lint fix:format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.101.1",
    "@vue-dnd-kit/core": "^2.4.6",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.7.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "vue-demi@0.14.10": true
  }
}
